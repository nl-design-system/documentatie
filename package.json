{
  "name": "@nl-design-system/website",
  "author": "Community for NL Design System",
  "description": "Design Tokens for the documentation of NL Design System",
  "keywords": [
    "nl-design-system"
  ],
  "private": true,
  "license": "EUPL-1.2",
  "packageManager": "pnpm@11.28.2+sha512.755ce2fe3c05bfd7bb412b42aff3c5c55cd38c529c6eca810475497ae36746c571e4b6e1814e6e7e4b97d7ee864b8a0e44673c3b297a50e0ac28771c5ce15d27",
  "engines": {
    "//": "Update @types/node to match the highest node version here",
    "node": ">=24 <=25",
    "pnpm": "^11.4.0"
  },
  "repository": {
    "type": "git+ssh",
    "url": "git@github.com:nl-design-system/documentatie.git",
    "directory": "."
  },
  "scripts": {
    "prepare": "husky",
    "start": "pnpm run dev",
    "dev": "pnpm --filter @nl-design-system/website-astro run dev",
    "build": "pnpm run --recursive build",
    "clean": "npm-run-all clean:**",
    "clean:generated": "rimraf .docusaurus/ build/ dist/ tmp/",
    "clean:workspaces": "pnpm run --recursive clean",
    "serve": "http-server --port 3000 build/",
    "serve:astro": "pnpm --filter @nl-design-system/website-astro run preview",
    "serve:test-report": "pnpm exec playwright show-report tmp/playwright-html-report",
    "lint": "npm-run-all --continue-on-error lint:**",
    "lint:css": "stylelint --allow-empty-input '**/*.{css,scss}'",
    "lint:js": "eslint",
    "lint:package-json": "npmPkgJsonLint '**/package.json'",
    "lint:prettier": "prettier --check .",
    "lint:typescript": "tsc --noEmit --project tsconfig.node.json && tsc --noEmit --project tsconfig.test.json",
    "lint-fix": "npm-run-all --continue-on-error lint-fix:**",
    "lint-fix:css": "stylelint --fix '**/*.{css,scss}'",
    "lint-fix:js": "eslint --fix",
    "lint-fix:prettier": "prettier --write .",
    "lint-todo": "pnpm run --no-bail --recursive lint-todo",
    "changeset": "changeset add",
    "changeset:empty": "changeset --empty",
    "changeset:publish": "changeset publish",
    "changeset:status": "changeset status --since origin/main",
    "update-patch": "npm-check-updates --configFileName .ncurc.patch.mjs",
    "update-minor": "npm-check-updates --configFileName .ncurc.minor.mjs",
    "update-major": "npm-check-updates --configFileName .ncurc.major.mjs",
    "publish:argos": "argos upload ./tmp/screenshots",
    "test-update": "npm-run-all --sequential clean lint build",
    "test": "npm-run-all test:**",
    "test:rehype-plugin": "tsx rehype-trailing-slash.test.ts",
    "test:workspace": "pnpm run --recursive test"
  },
  "devDependencies": {
    "@argos-ci/playwright": "7.0.5",
    "@changesets/cli": "3.0.1",
    "@eslint/js": "9.39.2",
    "@eslint/json": "0.14.0",
    "@nl-design-system/eslint-config": "1.0.0",
    "@nl-design-system/tsconfig": "1.0.5",
    "@nl-design-system-community/documentation-components": "workspace:*",
    "@types/node": "24.10.9",
    "@types/unist": "3.0.3",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "1.6.0",
    "eslint-plugin-perfectionist": "4.15.1",
    "eslint-plugin-react": "7.37.5",
    "glob": "11.1.0",
    "globals": "15.15.0",
    "http-server": "14.1.1",
    "husky": "9.1.7",
    "lint-staged": "15.5.2",
    "npm-check-updates": "22.2.9",
    "npm-package-json-lint": "8.0.0",
    "npm-run-all": "4.1.5",
    "prettier": "3.8.1",
    "prettier-plugin-astro": "0.14.1",
    "rimraf": "6.1.2",
    "stylelint": "16.26.1",
    "stylelint-config-standard-scss": "14.0.0",
    "stylelint-order": "6.0.4",
    "stylelint-use-logical": "2.1.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0",
    "unist-util-visit": "5.1.0"
  },
  "overrides": {
    "flux": {
      "react": "^16 || ^17 || ^18",
      "react-dom": "^16 || ^17 || ^18"
    },
    "mini-create-react-context": {
      "react": "^16 || ^17 || ^18",
      "react-dom": "^16 || ^17 || ^18"
    }
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
