---
import { navigation } from '../navigation.config.ts';
import { SitemapList } from './_sitemap-list.tsx';
import PageBodyContentLayout from '@layouts/page-body-content.astro';
import { Grid } from '@nl-design-system-community/documentation-components/src/grid/grid.tsx';
import { Heading } from '@nl-design-system-community/documentation-components/src/heading/heading.tsx';
import '@nl-design-system-candidate/link-css/link.css';
import { Paragraph } from '@nl-design-system-community/documentation-components/src/paragraph/paragraph.tsx';

const { navigationTree, navigationList } = (await navigation)();
---

<PageBodyContentLayout
  title="Sitemap"
  description="Een compleet overzicht van alle pagina's in deze website"
  index={false}
>
  <Grid>
    <Grid.Cell span="all" className="ma-flow">
      <Heading level={1}>Sitemap</Heading>
      <Paragraph>In totaal heeft de website {navigationList.length} pagina's</Paragraph>
      {navigationTree.items.map((navigationGroup) => <SitemapList navigationGroup={navigationGroup} />)}
    </Grid.Cell>
  </Grid>
</PageBodyContentLayout>
