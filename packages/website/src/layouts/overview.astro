---
import Document, { type Props as DocumentProps } from './document.astro';
import {
  BreadcrumbNav,
  BreadcrumbNavLink,
  BreadcrumbNavSeparator,
} from '@nl-design-system-community/documentation-components/src/breadcrumb-nav/breadcrumb-nav';
import { IconChevronRight } from '@nl-design-system-community/documentation-components/src/functional-icon';
import { SideNavigation } from '@nl-design-system-community/documentation-components/src/side-navigation/side-navigation.tsx';
import { navigation } from '../navigation.config.ts';
import { getBreadcrumbsForElement } from '@nl-design-system-community/documentation-index/src/navigation/get-breadcrumbs-for-element.ts';
import './overview.css';
import { withCurrentIndication } from '@nl-design-system-community/documentation-index/src/navigation/with-current-indication';
import { serialiseNavigationTree } from '@nl-design-system-community/documentation-index/src/navigation/serialise-navigation-tree';
import { i18n } from '@nl-design-system-community/documentation-i18n/src/index';

export type Props = DocumentProps;

const { navigationTree, navigationList } = await withCurrentIndication(navigation, Astro.url.pathname);
const breadcrumbPath = getBreadcrumbsForElement(navigationList, Astro.url.pathname);
const treeLevelOne = navigationTree.items.find((item) => item.expanded || item.current);
const items = serialiseNavigationTree(treeLevelOne);
const { ...props } = Astro.props;
---

<Document {...props}>
  <div class="ma-layout-overview">
    <div class="ma-layout-overview__content">
      <div class="ma-layout-overview__side-nav">
        <h2 id="side-navigation-label" class="sr-only">{items.label} {i18n[props.lang].subnavigation}</h2>
        <SideNavigation
          aria-labelledby="side-navigation-label"
          items={[items.items || []]}
          closeLabel={i18n[props.lang || 'nl'].close}
          client:load
        />
      </div>

      {
        breadcrumbPath.length > 0 && (
          <BreadcrumbNav className="ma-layout-overview__breadcrumb-nav" label={i18n[props.lang].breadcrumbLabel}>
            {breadcrumbPath.map((item, index, list) => (
              <>
                <BreadcrumbNavLink
                  index={index}
                  href={item.href || ''}
                  disabled={!item.href || item.href === Astro.url.pathname}
                  aria-current={item.href === Astro.url.pathname ? 'page' : null}
                  lang={item.lang}
                >
                  {item.label}
                </BreadcrumbNavLink>
                {index < list.length - 1 ? (
                  <BreadcrumbNavSeparator>
                    <IconChevronRight />
                  </BreadcrumbNavSeparator>
                ) : null}
              </>
            ))}
          </BreadcrumbNav>
        )
      }

      <main id="main" class="ma-layout-overview__main ma-flow" lang={props.lang === 'en' ? 'en' : null}>
        <header class="ma-layout-overview__header ma-flow"><slot name="header" /></header>
        <div class="ma-layout-overview__main-body ma-flow ma-body-copy">
          <slot />
        </div>
      </main>
    </div>
  </div>
</Document>
