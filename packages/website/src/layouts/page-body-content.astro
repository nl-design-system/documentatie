---
import Document, { type Props as DocumentProps } from './document.astro';
import { PageBodyContent, PageBodyWrapper } from '@components/page-body/page-body';

export type Props = DocumentProps;

/**
 * This layout gives a default PageBody layout where the main content is centered in the page.
 */
const { ...props } = Astro.props;
---

<Document {...props}>
  <PageBodyWrapper Component="main" id="main" class="ma-flow" lang={props.lang === 'en' ? 'en' : null}>
    <PageBodyContent>
      <slot />
    </PageBodyContent>
  </PageBodyWrapper>
</Document>
