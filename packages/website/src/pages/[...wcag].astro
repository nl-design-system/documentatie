---
import { getCollection } from 'astro:content';
import { render } from 'astro:content';
import DetailLayout from '@layouts/detail.astro';
import OverviewLayout from '@layouts/overview.astro';
import { Grid } from '@nl-design-system-community/documentation-components/src/grid/grid.tsx';
import { Heading } from '@nl-design-system-community/documentation-components/src/heading/heading.tsx';
import { Paragraph } from '@nl-design-system-community/documentation-components/src/paragraph/paragraph.tsx';
import { DataBadge } from '@nl-design-system-community/documentation-components/src/data-badge/data-badge.tsx';
import { MDXComponents } from '@utils/mdx-components.astro';
import { navigation } from '../navigation.config.ts';
import { InlineHeadingGroup } from '@nl-design-system-community/documentation-components/src/components/InlineHeadingGroup.tsx';
import { getNavigationElement } from '@nl-design-system-community/documentation-index/src/navigation/get-navigation-element.ts';
import { isNavigationGroup } from '@nl-design-system-community/documentation-index/src/navigation/index.ts';

export async function getStaticPaths() {
  const wcag = await getCollection('wcag');

  return wcag.map((page) => ({
    params: { wcag: page.id },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);

const description =
  page.data.title && page.data.description ? `${page.data.title}: ${page.data.description}` : page.data.description;

const { navigationList } = (await navigation)();
const navigationElement = getNavigationElement(navigationList, Astro.url.pathname);
const navigationGroup = isNavigationGroup(navigationElement) ? navigationElement : navigationElement?.parent;

const components = await MDXComponents({ navigationItems: navigationGroup?.items });
const Layout =
  page.data?.page_layout === 'overview' || page.data?.hide_table_of_contents ? OverviewLayout : DetailLayout;
---

<Layout
  title={page.data.title}
  titleSm={page.data.title_sm}
  description={description}
  lang={page.data.lang}
  translations={page.data.translations}
  seoImage={page.data.image}
  seoImageAlt={page.data.image_alt}
  keywords={['wcag', page.data.title?.toLowerCase() || '', ...(page.data.keywords || [])]}
  index={page.data.unlisted !== true}
>
  <Grid slot="header">
    <Grid.Cell span="all">
      <InlineHeadingGroup>
        <Heading level={1}>{page.data.title}</Heading>
        {
          page.data.conformance_level && (
            <Paragraph>
              <DataBadge>{page.data.conformance_level}</DataBadge>
            </Paragraph>
          )
        }
      </InlineHeadingGroup>
      {page.data.lead && <Paragraph purpose="lead">{page.data.lead}</Paragraph>}
    </Grid.Cell>
  </Grid>

  <Grid>
    <Grid.Cell span="all" className="ma-flow">
      <Content components={components} />
    </Grid.Cell>
  </Grid>
</Layout>
