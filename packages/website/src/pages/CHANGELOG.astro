---
import PageBodyContentLayout from '@layouts/page-body-content.astro';
import { MDXComponents } from '@utils/mdx-components.astro';
import { Grid } from '@nl-design-system-community/documentation-components/src/grid/grid';
import { Heading } from '@nl-design-system-community/documentation-components/src/heading/heading';
import { Paragraph } from '@nl-design-system-community/documentation-components/src/paragraph/paragraph';
import { getEntry, render } from 'astro:content';

const page = await getEntry('changelog', 'CHANGELOG');
const { Content } = await render(page);
const components = await MDXComponents();

const title = 'Changelog';
const description = 'De changelog van de nldesignsystem.nl website';
---

<PageBodyContentLayout title={title} description={description}>
  <Grid>
    <Grid.Cell span="all" className="ma-flow">
      <Heading level={1}>{title}</Heading>
      <Paragraph purpose="lead">{description}</Paragraph>
    </Grid.Cell>
  </Grid>

  <Grid>
    <Grid.Cell className="ma-flow" span="all">
      <Content components={components} />
    </Grid.Cell>
  </Grid>
</PageBodyContentLayout>
