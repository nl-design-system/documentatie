---
import { getCollection } from 'astro:content';
import componentProgress from '@nl-design-system/component-progress/dist/index.json';
import { render } from 'astro:content';
import DetailLayout from '@layouts/detail.astro';
import OverviewLayout from '@layouts/overview.astro';
import { MDXComponents } from '@utils/mdx-components.astro';
import { Grid } from '@nl-design-system-community/documentation-components/src/grid/grid.tsx';
import { Heading } from '@nl-design-system-community/documentation-components/src/heading/heading.tsx';
import { Paragraph } from '@nl-design-system-community/documentation-components/src/paragraph/paragraph.tsx';
import { Flex } from '@nl-design-system-community/documentation-components/src/flex/flex.tsx';
import { ComponentIllustration } from '@nl-design-system-community/documentation-components/src/component-illustration/component-illustration.tsx';
import { EstafetteBadge } from '@nl-design-system-community/documentation-components/src/components/EstafetteBadge.tsx';
import { InlineHeadingGroup } from '@nl-design-system-community/documentation-components/src/components/InlineHeadingGroup.tsx';
import { navigation } from '../navigation.config.ts';
import '@nl-design-system-community/documentation-components/src/components/ComponentPage.css';
import '@nl-design-system-community/documentation-components/src/components/EstafetteBadge.css';
import './[...component].css';

export async function getStaticPaths() {
  const components = await getCollection('components');

  // Find all modules with aliases for the components
  const aliasesModules = import.meta.glob(
    '../../../../node_modules/@nl-design-system-candidate/*-docs/docs/aliases.md',
    { eager: true },
  ) as Record<string, { default: any }>;

  return components.map((page) => {
    const aliasModuleKey = Object.keys(aliasesModules).find((key) => key.includes(page.id + '-docs'));

    // Aliases component dymaically imported for current component file
    const Aliases = aliasModuleKey ? aliasesModules[aliasModuleKey].default : null;

    return {
      params: { component: page.id },
      props: { page, Aliases },
    };
  });
}

const { navigationList } = (await navigation)();
const { page, Aliases } = Astro.props;
const { Content } = await render(page);

const selectedStatusOptions = {
  HELP_WANTED: 'Help Wanted',
  COMMUNITY: 'Community',
  CANDIDATE: 'Candidate',
  HALL_OF_FAME: 'Hall of Fame',
};
const component = componentProgress.find((item) => item.number === page.data.issue_number);
const status = selectedStatusOptions[component.relayStep];

const description =
  page.data.title && page.data.description ? `${page.data.title}: ${page.data.description}` : page.data.description;

const Layout =
  page.data?.page_layout === 'overview' || page.data?.hide_table_of_contents ? OverviewLayout : DetailLayout;
const components = await MDXComponents({ navigationList });
---

<Layout
  title={page.data.title}
  titleSm={page.data.title_sm}
  description={description}
  lang={page.data.lang}
  translations={page.data.translations}
  seoImage={page.data.image}
  seoImageAlt={page.data.image_alt}
  keywords={['component', page.data.title?.toLowerCase() || '', ...(page.data.keywords || [])]}
  index={page.data.unlisted !== true}
>
  <Grid slot="header">
    <Grid.Cell span="all">
      <Flex align="center">
        <InlineHeadingGroup>
          <Heading level={1}>{component.title}</Heading>
          {
            status && (
              <Paragraph>
                <EstafetteBadge state={status} />
              </Paragraph>
            )
          }
        </InlineHeadingGroup>
      </Flex>
      {page.data.description && <Paragraph purpose="lead">{page.data.description}</Paragraph>}
    </Grid.Cell>

    {
      Aliases ? (
        <Grid.Cell span="all">
          <Aliases />
        </Grid.Cell>
      ) : null
    }

    {
      ['Help Wanted', 'Community'].includes(status) && (
        <Grid.Cell span="all">
          <ComponentIllustration
            relayStep={status}
            description={`Schets van de ${page.data.title} component`}
            name={page.data.title}
          />
        </Grid.Cell>
      )
    }
  </Grid>

  <Grid>
    <Grid.Cell className="ma-flow" span="all">
      <Content components={components} />
    </Grid.Cell>
  </Grid>
</Layout>
