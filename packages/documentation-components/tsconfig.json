{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "composite": true,
    "emitDeclarationOnly": true,
    "lib": ["DOM", "ESNext"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "outDir": "./dist/",
    "rootDir": "./src/"
  },
  "include": ["./src/**/*.ts", "./src/**/*.tsx", "./src/**/*.json"]
}
