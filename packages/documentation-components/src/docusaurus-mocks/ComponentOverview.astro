---
import { CardGroup } from '../components/CardGroup';
import { ComponentCard } from '../components/ComponentCard';
import { ComponentOverviewFilter } from './ComponentOverviewFilter';
import { getCollection } from 'astro:content';
import { COMPONENT_STATES, getComponentFrameworkNames, type Component } from '../utils';
import type { ComponentProgressObject } from '@nl-design-system/component-progress/dist/utils';

const components = await getCollection('components');
const { componentProgress } = Astro.props;
---

<ComponentOverviewFilter client:load />

<CardGroup>
  {
    components.map((item: ComponentProgressObject) => {
      const { title, description } = item.data;

      const component = (componentProgress as Component[]).find((item) => {
        return item.title === title;
      });

      if (!component) return null;

      const relayStep = component && COMPONENT_STATES[component.relayStep];
      const frameworkNames = getComponentFrameworkNames(component);

      return (
        <div
          class="ma-component-overview-list-item"
          data-status={relayStep.replace(' ', '_').toUpperCase()}
          data-framework-names={frameworkNames}
        >
          <ComponentCard
            name={title}
            headingLevel={2}
            href={item.id}
            description={description}
            relayStep={relayStep}
            frameworkNames={frameworkNames}
          />
        </div>
      );
    })
  }
</CardGroup>
